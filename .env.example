# Ports (OrbStack often uses 20000–20001; change if you get "port already allocated")
NGINX_HTTP_PORT=20100
MARIADB_PORT=20101
PHPMYADMIN_PORT=20102

# App
WP_URL=http://localhost:20100
WP_TITLE=Kirki Ecommerce Dev
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=demo
WP_ADMIN_EMAIL=admin@example.com

# Database
DB_NAME=kirki_ecommerce
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=root

# Xdebug
XDEBUG_MODE=off
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_CLIENT_PORT=9003
XDEBUG_IDEKEY=PHPSTORM
