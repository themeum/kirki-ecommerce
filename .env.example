# Ports and WP_URL below are managed by bin/dev-up: it picks free ports for this
# checkout, writes them here, and keeps them. Run bin/dev-urls to see them.
# These values are the Compose defaults when you run docker compose directly.
NGINX_HTTP_PORT=20100
MARIADB_PORT=20101
PHPMYADMIN_PORT=20102
# Vite dev server (npm run dev). bin/dev-up sets it from NGINX_HTTP_PORT, so
# each worktree can run its own dev server.
VITE_PORT=5173

# App
WP_URL=http://localhost:20100
WP_TITLE=Kirki Ecommerce Dev
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=demo
WP_ADMIN_EMAIL=admin@example.com
KECOM_WEBHOOK_BASE_URL=http://localhost:20100

# Database
DB_NAME=kirki_ecommerce
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=root

# Xdebug
XDEBUG_MODE=off
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_CLIENT_PORT=9003
XDEBUG_IDEKEY=PHPSTORM
