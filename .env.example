# Ports and WP_URL below are managed by bin/dev-up: it picks free ports for this
# checkout, writes them here, and keeps them. Run bin/dev-urls to see them.
# These values are the Compose defaults when you run docker compose directly.
NGINX_HTTP_PORT=20100
MARIADB_PORT=20101
PHPMYADMIN_PORT=20102
# Vite dev server (npm run dev). bin/dev-up sets it from NGINX_HTTP_PORT, so
# each worktree can run its own dev server.
VITE_PORT=5173

# App
WP_URL=http://localhost:20100
WP_TITLE=Kirki Ecommerce Dev
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=demo
WP_ADMIN_EMAIL=admin@example.com
KECOM_WEBHOOK_BASE_URL=http://localhost:20100

# Database
DB_NAME=kirki_ecommerce
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=root

# Payment gateways: npm run build:payments / publish:payments / s3:up
# The values below target the local S3 (npm run s3:up). To publish to a real
# bucket, change them as the comments say. A value set in the shell wins over this file.
# Host ports of the local S3 (docker-compose.payments.yml).
S3_PORT=9000
S3_CONSOLE_PORT=9001
# S3 endpoint for the AWS CLI. Set it to an empty value (S3_ENDPOINT=) for AWS S3.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=kirki-payments
# Optional folder inside the bucket (for example gateways). Empty = bucket root.
# BASE_URL and ICON_BASE_URL must then end with the same folder.
S3_PREFIX=
# Credentials. The local S3 uses minioadmin for both. Use your own keys for a real bucket.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
# URLs written into the gateways/payments catalog. WordPress (in Docker) reads
# BASE_URL; the browser loads logos from ICON_BASE_URL. On a real bucket both are
# the public bucket URL, e.g. https://my-bucket.s3.amazonaws.com
BASE_URL=http://host.docker.internal:9000/kirki-payments
ICON_BASE_URL=http://localhost:9000/kirki-payments

# Xdebug
XDEBUG_MODE=off
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_CLIENT_PORT=9003
XDEBUG_IDEKEY=PHPSTORM
