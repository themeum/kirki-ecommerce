{
  "scripts": {
    "dev:app": "npm run dev --prefix resources/app",
    "dev:site": "npm run dev --prefix resources/site",
    "dev": "npm run dev:app & npm run dev:site",
    "make:package": "bash bin/make-package.sh",
    "make:pot": "bash bin/make-pot.sh",
    "build:payments": "node bin/build-payment-zips.js",
    "publish:payments": "node bin/publish-payment-gateways.js",
    "test:payments": "node --test bin/test/*.test.js",
    "s3:up": "docker compose -f docker-compose.payments.yml up -d s3 && docker compose -f docker-compose.payments.yml run --rm s3-setup",
    "s3:down": "docker compose -f docker-compose.payments.yml down",
    "make:payment-loader-plugin": "bash dev-tools/load-kirki-payment-gateways/build.sh",
    "search:index": "npm run search:index --prefix resources/app",
    "test:app": "npm run test --prefix resources/app",
    "test:php": "composer test:docker",
    "test:php:unit": "bash kirki-ecommerce-test unit",
    "test:php:integration": "bash kirki-ecommerce-test integration",
    "test": "npm run test:php && npm run test:app",
    "typecheck:app": "npm run typecheck --prefix resources/app"
  }
}
