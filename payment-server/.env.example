# Port the server listens on.
PORT=4800

# Public URL WordPress uses to reach this server (catalog and zip downloads).
# In Docker dev, WordPress reaches the host as host.docker.internal.
BASE_URL=http://host.docker.internal:4800

# Public URL the browser uses to load logos. Defaults to http://localhost:PORT.
# Set it to the same value as BASE_URL on a real server.
ICON_BASE_URL=http://localhost:4800

# Folder with the built gateways. Defaults to ./build.
# GATEWAYS_DIR=./gateways
