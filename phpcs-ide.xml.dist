<?xml version="1.0"?>
<ruleset name="kirki-ecommerce-ide">
    <description>
        Editor-only ruleset: runs phpcs.xml.dist (PSR12 + docblocks) and
        phpcs-wporg.xml.dist (WordPress.org checks) together so the IDE shows
        both. CLI and CI keep running each ruleset on its own.
    </description>

    <rule ref="./phpcs.xml.dist"/>
    <rule ref="./phpcs-wporg.xml.dist"/>
</ruleset>
