# WordPress test suite (see bin/install-wp-tests.sh)
WP_TESTS_DIR=/tmp/wordpress-tests-lib
WP_CORE_DIR=/tmp/wordpress

# Test database (separate from local dev kirki_ecommerce)
DB_NAME=kirki_ecommerce_test
DB_USER=wordpress
DB_PASSWORD=wordpress
# Optional. Without it the tests use 127.0.0.1 and MARIADB_PORT from the root .env
# (saved by bin/dev-up; see bin/dev-urls), or 20101.
# DB_HOST=127.0.0.1:20101
